# Loaded from project root; process environment wins. Prefer provider settings UI.
APP_DEMO_ENABLED=true
APP_ALLOWED_HOSTS=127.0.0.1,localhost,[::1],testserver
APP_ADMIN_PASSWORD=
# Optional 32 random bytes, URL-safe Base64; otherwise .runtime/vault.key is generated.
APP_SECRET_KEY=
# Leave DATABASE_URL unset for SQLite .runtime/impact.sqlite.
# DATABASE_URL=postgresql://alfa:YOUR_PASSWORD@127.0.0.1:5432/alfa_impact
# MATERIALS_DIR=/absolute/path/to/materials
# APP_RUNTIME_DIR=/absolute/path/to/runtime
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_API_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=3000
LLM_MAX_CALLS_PER_DAY=50
LLM_INPUT_RUB_PER_1M=
LLM_OUTPUT_RUB_PER_1M=
LLM_DAILY_BUDGET_RUB=500
POSTGRES_PASSWORD=
