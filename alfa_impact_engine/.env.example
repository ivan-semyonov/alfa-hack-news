# Values are examples only; the app reads process environment, not this file.
# Default local RULES mode never sends article text to a provider.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Technical ID supplied by the selected provider; never guessed from display name.
LLM_API_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=1500
LLM_MAX_CALLS_PER_DAY=50
# Without both prices, RUB cost is UNKNOWN; only the attempt/token limits apply.
LLM_INPUT_RUB_PER_1M=
LLM_OUTPUT_RUB_PER_1M=
LLM_DAILY_BUDGET_RUB=500
POSTGRES_PASSWORD=local_demo_only_not_for_production
